{
  "name": "qinglan-world-b68eab",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "durable_objects": {
    "bindings": [
      {
        "name": "QINGLAN_WORLD",
        "class_name": "QinglanWorld"
      }
    ]
  },
  "exports": {
    "QinglanWorld": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "WORLD_NAME": "global",
    "ART_STYLE_MODEL": "@cf/stabilityai/stable-diffusion-xl-base-1.0",
    "ART_TEXTURE_MODEL": "@cf/stabilityai/stable-diffusion-xl-base-1.0"
  },
  "assets": {
    "directory": "../../dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/socket"
    ]
  },
  "ai": {
    "binding": "AI"
  }
}
